# Template: copy to secret.yaml (git-ignored) and set real values.
# Use letters and digits only: clients embed it in
# RABBITMQ_URL=amqp://<user>:<password>@rabbitmq:5672
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secret
  namespace: ecommerce
type: Opaque
stringData:
  RABBITMQ_DEFAULT_USER: "ecommerce"
  RABBITMQ_DEFAULT_PASS: "changeMeRabbit123"
