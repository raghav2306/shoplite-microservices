# Template: copy to secret.yaml (git-ignored) and set real values.
# Use letters and digits only: it is embedded in the service's MONGO_URI.
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-products-secret
  namespace: ecommerce
type: Opaque
stringData:
  MONGO_INITDB_ROOT_USERNAME: "root"
  MONGO_INITDB_ROOT_PASSWORD: "changeMeProducts123"
